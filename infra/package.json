{
  "name": "nakomis-scrum-infra",
  "version": "0.1.0",
  "private": true,
  "main": "bin/app.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --passWithNoTests",
    "cdk": "cdk",
    "deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --all --require-approval never --profile nakom.is-sandbox",
    "deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --all --require-approval never --profile nakom.is-admin",
    "ci-synth-sandbox": "NPM_ENVIRONMENT=sandbox cdk synth --all --output cdk-synth.out",
    "ci-deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --require-approval never --output cdk-deploy.out",
    "ci-deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --require-approval never --output cdk-deploy.out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3",
    "@aws-sdk/client-dynamodb": "^3",
    "@aws-sdk/lib-dynamodb": "^3",
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8",
    "@types/jest": "^29",
    "@types/node": "^22",
    "aws-cdk": "^2.180.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.71.2"
  }
}
